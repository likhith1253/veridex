# Database
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/sentinel

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# API
API_HOST=127.0.0.1
API_PORT=8000
SENTINEL_API_KEY=
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000

# LLM Providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=

# Environment
ENVIRONMENT=development

# Razorpay Test Mode & Webhook Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
