# Copy to .env and fill in. Never commit real values.

# --- Database (required) ---------------------------------------------------
# Async SQLAlchemy URL. Tests derive a separate "<name>_test" database from it
# (or use TEST_DATABASE_URL if set) and never touch this one.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/sentinel
# TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/sentinel_test

# --- Runtime environment ---------------------------------------------------
# development | test | production. In production the backend FAILS CLOSED:
# if no API key below is set, every protected route returns 503.
ENVIRONMENT=development
# SENTINEL_ENV=            # legacy alias for ENVIRONMENT

# --- API access control ----------------------------------------------------
# Shared key required in the X-API-Key header (or "Authorization: Bearer ...")
# on every route except /, /health and the HMAC-verified webhook endpoints.
# Any of these names is accepted, first non-empty wins:
# VERIDEX_API_KEY, SENTINEL_API_KEY, API_KEY. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_API_KEY=
# Comma-separated browser origins allowed by CORS. Unset => localhost:3000/8501
# only. "*" is ignored on purpose.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501
API_HOST=127.0.0.1
API_PORT=8000

# --- LLM providers (optional: a deterministic fake client is used without a key)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=            # alias: GOOGLE_API_KEY

# --- Vector database (optional) --------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Razorpay (test mode) --------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED for webhooks: with no secret set, all webhook deliveries are rejected.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1
